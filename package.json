{
  "name": "@webship.co/workspace-wagtail",
  "version": "1.0.0",
  "description": "Wagtail for Webship Workspace: the builder (`cmd-wagtail-project.sh`, a new project made with wagtail start, or the official Wagtail Bakery demo with its content, at the current release line or the long-term-support one, run in production by uWSGI in containers with PostgreSQL and a mail catcher) and the manage.py tool in every sites folder, the default accounts, the Wagtail step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-wagtail.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "wagtail",
    "label": "Wagtail",
    "summary": "A builder for Wagtail sites (a new project, or the Bakery demo with its content), and the manage.py tool",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-wagtail-project.sh",
        "commands/cmd-tools-wagtail-manage.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-wagtail.sh"
      ],
      "args": [
        "scripts/args/arg-wagtail.sh",
        "scripts/args/arg-wagtail-manage.sh"
      ],
      "machine": [
        "scripts/wagtail-site.py",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/wagtail-site-builder.md",
        "ai/agents/wagtail-tester.md"
      ],
      "skills": [
        "ai/skills/wagtail-scenarios"
      ],
      "commands": [
        "ai/commands/wagtail-test.md"
      ],
      "prompts": [
        "ai/prompts/wagtail-build-and-test.md",
        "ai/prompts/wagtail-scenarios-for-an-area.md"
      ]
    },
    "features": [
      "features/wagtail.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
